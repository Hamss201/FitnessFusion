<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/ff_background"
    tools:context=".signUp">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="214dp"
        android:layout_height="175dp"
        app:srcCompat="@drawable/fitfun_logo" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="25dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/ca_tv206"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create an Account"
                android:textAlignment="center"
                android:textSize="30dp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/name206"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="30dp"
                android:padding="10dp"
                android:ems="10"
                android:inputType="text"
                android:hint="Full Name" />

            <EditText
                android:id="@+id/email206"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="15dp"
                android:padding="10dp"
                android:ems="10"
                android:hint="Email"
                app:layout_constraintEnd_toEndOf="parent"
                tools:layout_editor_absoluteY="231dp" />

            <EditText
                android:id="@+id/phoneNo206"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="15dp"
                android:padding="10dp"
                android:ems="10"
                android:hint="Phone Number" />

            <EditText
                android:id="@+id/pass206"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="15dp"
                android:padding="10dp"
                android:ems="10"
                android:inputType="textPassword"
                android:hint="Password" />

            <Button
                android:id="@+id/button206"
                android:layout_width="200dp"
                android:layout_height="45dp"
                android:layout_gravity="center"
                android:backgroundTint="#256084"
                android:textSize="20dp"
                android:text="Done" />

            <Button
                android:id="@+id/reset206"
                android:layout_width="141dp"
                android:layout_height="36dp"
                android:backgroundTint="@color/white"
                android:text="Reset"
                android:textColor="#5b5b5b"
                android:layout_gravity="center"
                android:textSize="13dp" />

            <TextView
                android:id="@+id/txv206"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Have an Account? Login"
                android:textAlignment="center" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>




</LinearLayout>