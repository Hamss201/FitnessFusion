<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/ff_background"
    android:gravity="center"
    tools:context=".adminlogIn">

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="214dp"
        android:layout_height="175dp"
        app:srcCompat="@drawable/fitfun_logo" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        app:cardCornerRadius="25dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">


            <TextView
                android:id="@+id/adp_tv206"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Admin Login"
                android:textAlignment="center"
                android:textSize="30dp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/al_user206"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="30dp"
                android:ems="10"
                android:hint="Email"
                android:inputType="text"
                android:padding="10dp" />

            <EditText
                android:id="@+id/al_pass206"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="15dp"
                android:ems="10"
                android:hint="Password"
                android:inputType="textPassword"
                android:padding="10dp" />

            <Button
                android:id="@+id/al_Done206"
                android:layout_width="200dp"
                android:layout_height="45dp"
                android:backgroundTint="#256084"
                android:text="Done"
                android:textSize="20dp" />

            <Button
                android:id="@+id/al_reset206"
                android:layout_width="141dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:backgroundTint="@color/white"
                android:text="Reset"
                android:textColor="#5b5b5b"
                android:textSize="13dp" />

            <TextView
                android:id="@+id/tv4_206"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Go Back"
                android:textAlignment="center" />
        </LinearLayout>

    </androidx.cardview.widget.CardView>


</LinearLayout>